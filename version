-- State
-- ============================================================
local deleteAuraEnabled = false
local deleteRange       = 35
local flyEnabled        = false
local flySpeed          = 50

-- ============================================================
-- Delete Aura (solara method — descendant scan of workspace.Bricks)
-- ============================================================
local function startDeleteAura()
	task.spawn(function()
		while deleteAuraEnabled and gui.Parent do
			task.wait(0.1)
			local bricks = workspace:FindFirstChild("Bricks")
			local char   = LP.Character
			if not bricks or not char then continue end
			local origin = char:GetPivot().Position
			local parts  = {}
			for _, v in ipairs(bricks:GetDescendants()) do
				if v:IsA("BasePart") and v.Parent and (v.Position - origin).Magnitude <= deleteRange then
					parts[#parts + 1] = v
				end
			end
			for _, v in ipairs(parts) do
				if not deleteAuraEnabled then break end
				task.spawn(function()
					pcall(function()
						local c = LP.Character
						if not c then return end
						if LP.Backpack:FindFirstChild("Delete") then
							LP.Backpack.Delete.Parent = c
							task.wait()
						end
						if not c:FindFirstChild("Delete") then return end
						local tool = c.Delete
						local ev = tool:FindFirstChild("origevent")
						if ev then
							ev:Invoke(v, v.Position)
						else
							local sc = tool:FindFirstChild("Script")
							if sc and sc:FindFirstChild("Event") then
								sc.Event:FireServer(v, v.Position)
							end
						end
					end)
				end)
				task.wait(0.03)
			end
		end
	end)
end

-- ============================================================
-- Smooth Fly (BodyVelocity + velocity lerp)
-- ============================================================
local flyBV, flyConn
local flyCurrentVel = Vector3.zero

local function stopFly()
	if flyBV then flyBV:Destroy(); flyBV = nil end
	if flyConn then flyConn:Disconnect(); flyConn = nil end
	local c = LP.Character
	if c and c:FindFirstChild("HumanoidRootPart") then
		c.HumanoidRootPart.Velocity = Vector3.zero
	end
	flyCurrentVel = Vector3.zero
end

local function startFly()
	if not flyEnabled then return end
	stopFly()
	local char = LP.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	flyBV = Instance.new("BodyVelocity")
	flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
	flyBV.Velocity = Vector3.zero
	flyBV.Parent = hrp

	flyConn = RS.RenderStepped:Connect(function(dt)
		if not flyEnabled or not flyBV or not flyBV.Parent then return end
		local cam = workspace.CurrentCamera
		if not cam then return end
		local cf = cam.CFrame
		local move = Vector3.zero
		if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + cf.LookVector  end
		if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - cf.LookVector  end
		if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - cf.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + cf.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.yAxis end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
			move = move - Vector3.yAxis
		end
		if move.Magnitude > 0 then move = move.Unit end
		local target = move * flySpeed
		local alpha  = 1 - math.exp(-dt * 10)  -- frame-rate independent smoothing
		flyCurrentVel = flyCurrentVel:Lerp(target, alpha)
		flyBV.Velocity = flyCurrentVel
	end)
end

-- Respawn → restart fly if enabled
LP.CharacterAdded:Connect(function(char)
	if flyEnabled then
		char:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.3)
		if flyEnabled then startFly() end
	end
end)

