-- Tabs
local tabs = {}
local function makeTab(name, titleText)
	local btn = new("TextButton", {
		Text = "   " .. titleText, TextColor3 = COL_SUB, TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.Gotham, TextSize = 13, BackgroundTransparency = 1,
		Size = UDim2.new(1, -10, 0, 34), Position = UDim2.new(0, 5, 0, 5 + #tabs * 40),
		Parent = sidebar,
	})
	local page = new("ScrollingFrame", {
		Name = name, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageColor3 = COL_STROKE,
		CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false, Parent = content,
	})
	new("UIPadding", {
		PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 8), Parent = page,
	})
	new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = page })
	tabs[name] = { btn = btn, page = page }
	btn.MouseButton1Click:Connect(function()
		for _, t in pairs(tabs) do t.page.Visible = false; t.btn.TextColor3 = COL_SUB end
		page.Visible = true; btn.TextColor3 = COL_ACCENT
	end)
	btn.MouseEnter:Connect(function() if not page.Visible then btn.TextColor3 = COL_TEXT end end)
	btn.MouseLeave:Connect(function() if not page.Visible then btn.TextColor3 = COL_SUB end end)
	return page
end

local function makeSection(parent, text)
	return new("TextLabel", {
		Text = text, TextColor3 = COL_ACCENT, Font = Enum.Font.GothamBold, TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 22), Parent = parent,
	})
end

local function makeToggle(parent, label, default, callback)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = COL_PANEL,
		BorderSizePixel = 0, Parent = parent,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 6), Parent = row })
	new("TextLabel", {
		Text = "  " .. label, TextColor3 = COL_TEXT, TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.Gotham, TextSize = 13, BackgroundTransparency = 1,
		Size = UDim2.new(1, -70, 1, 0), Parent = row,
	})
	local track = new("Frame", {
		Size = UDim2.fromOffset(40, 20), Position = UDim2.new(1, -50, 0.5, -10),
		BackgroundColor3 = Color3.fromRGB(60, 60, 70), BorderSizePixel = 0, Parent = row,
	})
	new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })
	local knob = new("Frame", {
		Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 2, 0.5, -8),
		BackgroundColor3 = Color3.fromRGB(220, 220, 230), BorderSizePixel = 0, Parent = track,
	})
	new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })
	local btn = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = row })

	local state = default and true or false
	local function render(anim)
		local tPos = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
		local kCol = state and COL_ACCENT or Color3.fromRGB(220, 220, 230)
		local tCol = state and COL_ACCENT or Color3.fromRGB(60, 60, 70)
		if anim then
			TS:Create(knob,  TweenInfo.new(0.15), { Position = tPos, BackgroundColor3 = kCol }):Play()
			TS:Create(track, TweenInfo.new(0.15), { BackgroundColor3 = tCol }):Play()
		else
			knob.Position = tPos; knob.BackgroundColor3 = kCol; track.BackgroundColor3 = tCol
		end
	end
	render(false)
	btn.MouseButton1Click:Connect(function() state = not state; render(true); callback(state) end)
	return row
end

local function makeInput(parent, label, default, callback)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = COL_PANEL,
		BorderSizePixel = 0, Parent = parent,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 6), Parent = row })
	new("TextLabel", {
		Text = "  " .. label, TextColor3 = COL_TEXT, TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.Gotham, TextSize = 13, BackgroundTransparency = 1,
		Size = UDim2.new(0.55, 0, 1, 0), Parent = row,
	})
	local box = new("TextBox", {
		Text = tostring(default), PlaceholderText = tostring(default), PlaceholderColor3 = COL_SUB,
		TextColor3 = COL_TEXT, Font = Enum.Font.Gotham, TextSize = 13,
		BackgroundColor3 = COL_BG, BorderSizePixel = 0, ClearTextOnFocus = false,
		Size = UDim2.new(0.4, -10, 1, -8), Position = UDim2.new(0.6, 0, 0, 4), Parent = row,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 4), Parent = box })
	new("UIStroke", { Color = COL_STROKE, Thickness = 1, Parent = box })
	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then callback(n) else box.Text = tostring(default) end
	end)
	return row
end

